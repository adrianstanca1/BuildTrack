{
  "expo": {
    "name": "BuildTrack",
    "slug": "buildtrack",
    "scheme": "buildtrack",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "owner": "adrianstanca",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a365d"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ro.stancainvest.buildtrack",
      "buildNumber": "1.1.0.6",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BuildTrack needs your location to show nearby construction projects and sites.",
        "NSCameraUsageDescription": "BuildTrack uses the camera to capture photos of sites and safety documentation.",
        "NSPhotoLibraryUsageDescription": "BuildTrack needs photo library access to attach site photos to projects and safety reports.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "BuildTrack",
        "CFBundleName": "BuildTrack",
        "NSUserNotificationUsageDescription": "BuildTrack sends you notifications about project updates, task assignments, and safety alerts."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:buildtrack.cortexbuildpro.com"
      ]
    },
    "android": {
      "package": "ro.stancainvest.buildtrack",
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a365d"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1a365d",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#1a365d"
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "cd4364ab-e24c-4973-96fe-6191e9b20b5d"
      },
      "router": {}
    },
    "updates": {
      "url": "https://u.expo.dev/cd4364ab-e24c-4973-96fe-6191e9b20b5d",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
