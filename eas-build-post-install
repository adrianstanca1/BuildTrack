#!/bin/bash
set -e

# EAS Build post-install hook
# Runs AFTER npm install but BEFORE Xcode build
# Patches expo-modules-core for Xcode 16 / Swift 6 compatibility

echo "🔧 [eas-build-post-install] Running expo-modules-core patches..."

# Run patch-package
if [ -f "patches/expo-modules-core+55.0.25.patch" ]; then
    echo "  → Applying patch-package patches..."
    npx patch-package || echo "  ⚠️ patch-package failed"
fi

# Also run manual patch script for any files patch-package missed
if [ -f "scripts/patch-expo-modules.js" ]; then
    echo "  → Running manual patch script..."
    node scripts/patch-expo-modules.js || echo "  ⚠️ manual patch failed"
fi

echo "✅ [eas-build-post-install] Complete"
