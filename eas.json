{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "http://127.0.0.1:54321",
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:54321/api"
      },
      "ios": {
        "resourceClass": "medium"
      },
      "android": {
        "resourceClass": "medium"
      },
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://buildtrack.cortexbuildpro.com",
        "EXPO_PUBLIC_API_URL": "https://buildtrack.cortexbuildpro.com/api"
      },
      "android": {
        "buildType": "apk",
        "resourceClass": "medium"
      },
      "ios": {
        "resourceClass": "medium",
        "simulator": false
      },
      "channel": "preview",
      "autoIncrement": true
    },
    "production": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://buildtrack.cortexbuildpro.com",
        "EXPO_PUBLIC_API_URL": "https://buildtrack.cortexbuildpro.com/api"
      },
      "ios": {
        "resourceClass": "medium"
      },
      "channel": "production"
    },
    "production-android": {
      "extends": "production",
      "android": {
        "resourceClass": "medium"
      },
      "channel": "production-android"
    },
    "production-ios": {
      "extends": "production",
      "ios": {
        "resourceClass": "medium"
      },
      "channel": "production-ios"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6767887054",
        "ascApiKeyId": "S7PSXPJ963",
        "ascApiKeyIssuerId": "4e694aa4-8cbc-4de4-bdf2-0ace72694564",
        "ascApiKeyPath": "/root/.config/apple-v2/AuthKey_S7PSXPJ963.p8"
      },
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}