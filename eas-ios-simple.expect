#!/usr/bin/expect -f
set timeout 300
set apple_password "Cumparavinde1"

# Arrow down sequence
set arrow_down "\033\[B"

spawn eas credentials --platform ios

expect {
    "Which build profile" {
        # Navigate to production-ios (last option = 4 downs from top)
        for {set i 0} {$i < 4} {incr i} {
            send $arrow_down
            sleep 0.1
        }
        send "\r"
        exp_continue
    }
    "Select your Apple Team Type" {
        # Navigate to Individual (3rd option = 2 downs)
        for {set i 0} {$i < 2} {incr i} {
            send $arrow_down
            sleep 0.1
        }
        send "\r"
        exp_continue
    }
    "Apple Team ID:" {
        sleep 0.5
        send "4G3G5MX9BH\r"
        exp_continue
    }
    "Build Credentials: Manage everything" {
        send "\r"
        exp_continue
    }
    "All: Set up all" {
        send "\r"
        exp_continue
    }
    # When Apple ID prompt shows with gray hint, JUST press Enter to accept it
    -re "Apple ID:.*adrian.stanca1@icloud.com" {
        sleep 0.5
        # Just press Enter to accept the saved Apple ID
        send "\r"
        exp_continue
    }
    # Fallback: if Apple ID prompt without the hint
    "Apple ID:" {
        sleep 0.5
        send "adrian.stanca1@icloud.com\r"
        exp_continue
    }
    -re "Password.*adrian.stanca1" {
        sleep 0.5
        send "$apple_password\r"
        exp_continue
    }
    "Generate a new Apple Developer Program membership certificate" {
        sleep 0.5
        send "\r"
        exp_continue
    }
    "Generate a new Apple Developer Program provisioning profile" {
        sleep 0.5
        send "\r"
        exp_continue
    }
    "two-factor" {
        puts "\n\n[2FA REQUIRED]"
        puts "Check your Apple device for 6-digit code."
        interact
    }
    "verification code" {
        puts "\n\n[2FA REQUIRED]"
        interact
    }
    "Press any key to continue" {
        send "\r"
        exp_continue
    }
    "Error" {
        puts "\n\n[ERROR]"
        exit 1
    }
    "locked" {
        puts "\n\n[ACCOUNT LOCKED]"
        exit 1
    }
    timeout {
        puts "\n\n[TIMEOUT]"
        exit 1
    }
    eof {
        puts "\n\n[COMPLETED]"
        exit 0
    }
}
