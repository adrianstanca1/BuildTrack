# Copy to .env and fill in your values

# Supabase — REQUIRED. The app will fail to launch if either is unset.
# Local dev: run `supabase status` from /root/BuildTrack and copy the
# `anon key` (or `publishable key`) value below.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API — optional; defaults derived from EXPO_PUBLIC_SUPABASE_URL + channel.
EXPO_PUBLIC_API_URL=https://api.example.com
