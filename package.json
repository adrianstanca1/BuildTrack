{
  "name": "buildtrack",
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "patch-package || true && node scripts/patch-expo-router.js || true && rm -rf node_modules/@nozbe/watermelondb/node_modules/react node_modules/@nozbe/watermelondb/node_modules/react-dom || true"
  },
  "dependencies": {
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@expo/vector-icons": "^15.0.3",
    "@nozbe/watermelondb": "^0.25.5",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@stripe/stripe-react-native": "^0.65.1",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.9",
    "expo": "~55.0.26",
    "expo-asset": "~55.0.17",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.16",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.7",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.15",
    "expo-local-authentication": "~55.0.13",
    "expo-location": "^55.1.10",
    "expo-notifications": "~55.0.22",
    "expo-router": "~55.0.16",
    "expo-secure-store": "^55.0.14",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-task-manager": "^55.0.16",
    "expo-updates": "~55.0.24",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.2.3",
    "patch-package": "^8.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.86.0",
    "react-native-blob-util": "^0.24.7",
    "react-native-chart-kit": "^6.12.2",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.4",
    "sucrase": "^3.35.1",
    "tailwindcss": "^3.4.4",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/simdjson"
        ],
        "listUnknownPackages": false
      }
    },
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-svg",
        "@stripe/stripe-react-native"
      ]
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@nozbe/watermelondb": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "postcss": "^8.5.10"
  }
